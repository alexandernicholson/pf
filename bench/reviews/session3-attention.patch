+#if defined(PF_X86_ATTN_ROUNDED) && defined(__AVX2__) && defined(__GNUC__) && !defined(__clang__)
+#define HAVE_X86_ATTN_ROUNDED 1
+/* Experimental arithmetic policy: retain the benchmark baseline's separately
+ * rounded multiply and add. The production compiler may contract the old C
+ * loop, so compare production-built outputs before enabling this by default. */
+static __attribute__((noinline, optimize("fp-contract=off")))
+void attention_v_rounded_x86(const float *sc, float den, const float *v,
+                             int W, float *o) {
+    __m256 acc[HD / 8];
+    for (int i = 0; i < HD / 8; i++) acc[i] = _mm256_setzero_ps();
+    for (int j = 0; j < W; j++, v += KVD) {
+        __m256 weight = _mm256_set1_ps(sc[j] / den);
+        for (int i = 0; i < HD / 8; i++) {
+            __m256 product = _mm256_mul_ps(weight, _mm256_loadu_ps(v + 8 * i));
+            acc[i] = _mm256_add_ps(acc[i], product);
+        }
+    }
+    for (int i = 0; i < HD / 8; i++) _mm256_storeu_ps(o + 8 * i, acc[i]);
+}
+#endif
