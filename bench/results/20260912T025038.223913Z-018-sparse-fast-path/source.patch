+#elif defined(HAVE_X86_MOE)
+/* Sparse experts avoid the multi-token workspace and pointer setup entirely. */
+static void moe_single_x86(const bf16 *w1, const bf16 *b1, const bf16 *w2,
+                           const bf16 *b2, int it) {
+    float h1[2 * FF], h[FF];
+    const float *tb = R.tb + (size_t)(it / TOPK) * D;
+    cvt_bf16(b1, h1, 2 * FF);
+    for (int k = 0; k < D; k += 8)
+        axpy8_bf16(tb + k, w1 + (size_t)k * 2 * FF, 2 * FF, h1, 2 * FF);
+    swiglu_act(h1, h);
+    float *o = R.moe + (size_t)it * D;
+    cvt_bf16(b2, o, D);
+    for (int k = 0; k < FF; k += 8)
+        axpy8_bf16(h + k, w2 + (size_t)k * D, D, o, D);
+    for (int j = 0; j < D; j++) o[j] *= R.gates[it];
+}
+
+static __attribute__((noinline)) void moe_block(const bf16 *w1, const bf16 *b1, const bf16 *w2, const bf16 *b2,
+                      const int *blk, int m) {
+    float h1s[MOE_B][2 * FF], hs[MOE_B][FF];
+    const float *xp[MOE_B]; float *yp[MOE_B];
+    for (int i = 0; i < m; i++) {
+        xp[i] = R.tb + (size_t)(blk[i] / TOPK) * D;
+        yp[i] = h1s[i];
+        cvt_bf16(b1, h1s[i], 2 * FF);
+    }
+    moe_gemm_x86(w1, xp, yp, m, D, 2 * FF);
+    for (int i = 0; i < m; i++) {
+        swiglu_act(h1s[i], hs[i]);
+        xp[i] = hs[i];
+        yp[i] = R.moe + (size_t)blk[i] * D;
+        cvt_bf16(b2, yp[i], D);
+    }
+    moe_gemm_x86(w2, xp, yp, m, FF, D);
+    for (int i = 0; i < m; i++) {
+        float gw = R.gates[blk[i]];
+        for (int j = 0; j < D; j++) yp[i][j] *= gw;
+    }
+}
