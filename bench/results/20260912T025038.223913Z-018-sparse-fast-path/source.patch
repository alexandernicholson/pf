+static void moe_gemm_x86(const bf16 *w, const float *const *xs, float *const *ys,
+                          int B, int n_in, int n_out) {
+    /* Keep the existing efficient matrix-vector traversal for sparse experts. */
+    if (B == 1) {
+        for (int k = 0; k < n_in; k += 8)
+            axpy8_bf16(xs[0] + k, w + (size_t)k * n_out, n_out, ys[0], n_out);
+        return;
+    }
+    for (int kt = 0; kt < n_in; kt += PF_X86_MOE_KT) {
+        int kend = kt + PF_X86_MOE_KT;
+        if (kend > n_in) kend = n_in;
+        for (int j = 0; j < n_out; j += MOE_V * MOE_NV) {
+            int i = 0;
+            for (; i + 4 <= B; i += 4) {
+                moe_vec a0[MOE_NV], a1[MOE_NV], a2[MOE_NV], a3[MOE_NV];
+                for (int v = 0; v < MOE_NV; v++) {
+                    a0[v] = moe_load(ys[i] + j + v * MOE_V);
+                    a1[v] = moe_load(ys[i+1] + j + v * MOE_V);
+                    a2[v] = moe_load(ys[i+2] + j + v * MOE_V);
+                    a3[v] = moe_load(ys[i+3] + j + v * MOE_V);
+                }
+                for (int k = kt; k < kend; k++) {
+                    moe_vec x0 = moe_bcast(xs[i][k]);
+                    moe_vec x1 = moe_bcast(xs[i+1][k]);
+                    moe_vec x2 = moe_bcast(xs[i+2][k]);
+                    moe_vec x3 = moe_bcast(xs[i+3][k]);
+                    const bf16 *wk = w + (size_t)k * n_out + j;
+                    for (int v = 0; v < MOE_NV; v++) {
+                        moe_vec wv = moe_weight(wk + v * MOE_V);
+                        a0[v] = moe_fma(x0, wv, a0[v]);
+                        a1[v] = moe_fma(x1, wv, a1[v]);
+                        a2[v] = moe_fma(x2, wv, a2[v]);
+                        a3[v] = moe_fma(x3, wv, a3[v]);
+                    }
+                }
+                for (int v = 0; v < MOE_NV; v++) {
+                    moe_store(ys[i] + j + v * MOE_V, a0[v]);
+                    moe_store(ys[i+1] + j + v * MOE_V, a1[v]);
+                    moe_store(ys[i+2] + j + v * MOE_V, a2[v]);
+                    moe_store(ys[i+3] + j + v * MOE_V, a3[v]);
+                }
+            }
+            for (; i < B; i++) {
+                moe_vec a[MOE_NV];
+                for (int v = 0; v < MOE_NV; v++)
+                    a[v] = moe_load(ys[i] + j + v * MOE_V);
+                for (int k = kt; k < kend; k++) {
+                    moe_vec x = moe_bcast(xs[i][k]);
+                    const bf16 *wk = w + (size_t)k * n_out + j;
+                    for (int v = 0; v < MOE_NV; v++)
+                        a[v] = moe_fma(x, moe_weight(wk + v * MOE_V), a[v]);
+                }
+                for (int v = 0; v < MOE_NV; v++)
+                    moe_store(ys[i] + j + v * MOE_V, a[v]);
+            }
+        }
+    }
+}
